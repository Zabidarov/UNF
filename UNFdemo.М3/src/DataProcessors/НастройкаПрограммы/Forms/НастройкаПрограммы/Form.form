                    <value>Enum.ДаНет.EnumValue.Да</value>
                  </value>
                </choiceList>
                <choiceList>
                  <value xsi:type="core:ReferenceValue">
                    <value>Enum.ДаНет.EnumValue.Нет</value>
                  </value>
                </choiceList>
                <orientation>Vertical</orientation>
              </extInfo>
