////////////////////////////////////////////////////////////////////////////////
// Обмен с внешней CRM (demo-crm): получение контрагентов по REST API
// и запись полученных данных в справочник "Контрагенты".

#Область ПрограммныйИнтерфейс

// Получает контрагентов из CRM и записывает их в справочник "Контрагенты".
// Предназначена для вызова из регламентного задания "Обмен с CRM".
//
Процедура ПолучитьДанныеCRM() Экспорт
	
	Настройки = НастройкиПодключения();
	ДанныеКонтрагентов = ЗапроситьКонтрагентов(Настройки);
	
	Если ДанныеКонтрагентов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКонтрагентов(ДанныеКонтрагентов);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает параметры подключения к API CRM.
//
// Возвращаемое значение:
//  Структура - параметры подключения:
//   * АдресСервера - Строка - хост сервера, без указания протокола;
//   * АдресРесурса - Строка - путь к ресурсу, возвращающему список контрагентов;
//   * Таймаут       - Число  - таймаут соединения и операций, в секундах.
//
Функция НастройкиПодключения()
	
	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервера", "app-180396338.1cmycloud.com");
	Настройки.Вставить("АдресРесурса", "/applications/demo-crm/api/connect/customers/");
	Настройки.Вставить("Таймаут", 60);
	
	Возврат Настройки;
	
КонецФункции

// Запрашивает у API CRM список контрагентов.
//
// Параметры:
//  Настройки - Структура - параметры подключения, см. НастройкиПодключения().
//
// Возвращаемое значение:
//  Массив из Структура - данные контрагентов; Неопределено - при ошибке запроса.
//
Функция ЗапроситьКонтрагентов(Настройки)
	
	Ответ = ВыполнитьЗапросПоАдресу(Настройки, Настройки.АдресРесурса);
	
	Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
		АдресРедиректа = Ответ.Заголовки.Получить("Location");
		Если ЗначениеЗаполнено(АдресРедиректа) Тогда
			Ответ = ВыполнитьЗапросПоАдресу(Настройки, АдресРедиректа);
		КонецЕсли;
	КонецЕсли;
	
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписатьОшибкуВЖурнал(
			"Обмен с CRM.Получение контрагентов",
			СтрШаблон("Сервер вернул код состояния %1: %2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку()));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РазобратьОтвет(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	
КонецФункции

// Выполняет GET-запрос по защищенному соединению (HTTPS).
//
// Параметры:
//  Настройки - Структура - параметры подключения, см. НастройкиПодключения().
//  Адрес     - Строка    - абсолютный или относительный адрес ресурса.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ сервера.
//
Функция ВыполнитьЗапросПоАдресу(Настройки, Адрес)
	
	Сервер = Настройки.АдресСервера;
	Ресурс = Адрес;
	
	ПозицияПротокола = СтрНайти(Адрес, "://");
	Если ПозицияПротокола > 0 Тогда
		АдресБезПротокола = Сред(Адрес, ПозицияПротокола + 3);
		ПозицияРазделителя = СтрНайти(АдресБезПротокола, "/");
		Если ПозицияРазделителя > 0 Тогда
			Сервер = Лев(АдресБезПротокола, ПозицияРазделителя - 1);
			Ресурс = Сред(АдресБезПротокола, ПозицияРазделителя);
		Иначе
			Сервер = АдресБезПротокола;
			Ресурс = "/";
		КонецЕсли;
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(
		Сервер, , , , , Настройки.Таймаут, Новый ЗащищенноеСоединениеOpenSSL());
	
	Возврат Соединение.Получить(Новый HTTPЗапрос(Ресурс, ЗаголовкиЗапроса()));
	
КонецФункции

// Возвращает заголовки HTTP-запроса к API CRM.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заголовки запроса.
//
Функция ЗаголовкиЗапроса()
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	
	Возврат Заголовки;
	
КонецФункции

// Извлекает массив контрагентов из тела ответа API.
//
// Параметры:
//  ТелоОтвета - Строка - тело ответа в формате JSON.
//
// Возвращаемое значение:
//  Массив из Структура - данные контрагентов.
//
Функция РазобратьОтвет(ТелоОтвета)
	
	Если ПустаяСтрока(ТелоОтвета) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ЗначениеJSON = ПрочитатьЗначениеJSON(ТелоОтвета);
	
	Если ТипЗнч(ЗначениеJSON) = Тип("Массив") Тогда
		Возврат ЗначениеJSON;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеJSON) = Тип("Структура") Тогда
		Для Каждого ИмяПоля Из СтрРазделить("value,data,items,customers", ",") Цикл
			Данные = Неопределено;
			Если ЗначениеJSON.Свойство(ИмяПоля, Данные) И ТипЗнч(Данные) = Тип("Массив") Тогда
				Возврат Данные;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

// Записывает полученных контрагентов в справочник "Контрагенты".
//
// Параметры:
//  ДанныеКонтрагентов - Массив из Структура - данные контрагентов, полученные из API.
//
Процедура ЗагрузитьКонтрагентов(ДанныеКонтрагентов)
	
	Существующие = СуществующиеКонтрагенты();
	КоличествоЗаписей = 0;
	
	Для Каждого ДанныеКонтрагента Из ДанныеКонтрагентов Цикл
		Если ТипЗнч(ДанныеКонтрагента) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗаписатьКонтрагента(ДанныеКонтрагента, Существующие);
			КоличествоЗаписей = КоличествоЗаписей + 1;
		Исключение
			ЗаписатьОшибкуВЖурнал(
				"Обмен с CRM.Запись контрагента",
				СтрШаблон("Не удалось записать контрагента: %1", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(
		"Обмен с CRM.Загрузка контрагентов",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("Обработано записей: %1", КоличествоЗаписей));
	
КонецПроцедуры

// Возвращает индексы существующих контрагентов для поиска дублей.
//
// Возвращаемое значение:
//  Структура - индексы контрагентов:
//   * ПоИНН          - Соответствие из КлючИЗначение - ИНН -> СправочникСсылка.Контрагенты;
//   * ПоНаименованию - Соответствие из КлючИЗначение - наименование -> СправочникСсылка.Контрагенты.
//
Функция СуществующиеКонтрагенты()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления");
	
	Индексы = Новый Структура("ПоИНН, ПоНаименованию", Новый Соответствие, Новый Соответствие);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ИНН) Тогда
			Индексы.ПоИНН.Вставить(СокрЛП(Выборка.ИНН), Выборка.Ссылка);
		КонецЕсли;
		Индексы.ПоНаименованию.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Индексы;
	
КонецФункции

// Записывает одного контрагента в справочник "Контрагенты".
// Существующий элемент ищется по ИНН, при его отсутствии - по наименованию.
//
// Параметры:
//  ДанныеКонтрагента - Структура - данные контрагента, полученные из API.
//  Существующие      - Структура - индексы существующих контрагентов, см. СуществующиеКонтрагенты().
//
Процедура ЗаписатьКонтрагента(ДанныеКонтрагента, Существующие)
	
	Наименование = ЗначениеРеквизитаJSON(ДанныеКонтрагента, "Description,Наименование,Name,FullName");
	ИНН = ЗначениеРеквизитаJSON(ДанныеКонтрагента, "ИНН,INN");
	
	Если ПустаяСтрока(Наименование) И ПустаяСтрока(ИНН) Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = НайтиКонтрагента(Наименование, ИНН, Существующие);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Контрагент = Ссылка.ПолучитьОбъект();
	Иначе
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Контрагент.Наименование = Наименование;
	КонецЕсли;
	
	НаименованиеПолное = ЗначениеРеквизитаJSON(ДанныеКонтрагента, "FullName,НаименованиеПолное");
	Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
		Контрагент.НаименованиеПолное = НаименованиеПолное;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Контрагент.ИНН = ИНН;
	КонецЕсли;
	
	Контрагент.Записать();
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Если ЗначениеЗаполнено(ИНН) Тогда
			Существующие.ПоИНН.Вставить(ИНН, Контрагент.Ссылка);
		КонецЕсли;
		Существующие.ПоНаименованию.Вставить(Контрагент.Наименование, Контрагент.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Ищет контрагента по ИНН, а при его отсутствии - по наименованию.
//
// Параметры:
//  Наименование - Строка    - наименование контрагента.
//  ИНН          - Строка    - ИНН контрагента.
//  Существующие - Структура - индексы существующих контрагентов, см. СуществующиеКонтрагенты().
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - найденный контрагент; пустая ссылка - если не найден.
//
Функция НайтиКонтрагента(Наименование, ИНН, Существующие)
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Найденный = Существующие.ПоИНН.Получить(ИНН);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Найденный = Существующие.ПоНаименованию.Получить(Наименование);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

// Возвращает строковое значение первого заполненного свойства из списка.
//
// Параметры:
//  Данные     - Структура - данные контрагента, полученные из API.
//  ИменаПолей - Строка    - имена свойств через запятую, в порядке приоритета.
//
// Возвращаемое значение:
//  Строка - значение свойства; пустая строка - если ни одно свойство не заполнено.
//
Функция ЗначениеРеквизитаJSON(Данные, ИменаПолей)
	
	Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",") Цикл
		Значение = Неопределено;
		Если Данные.Свойство(ИмяПоля, Значение) И ЗначениеЗаполнено(Значение) Тогда
			Возврат СокрЛП(Строка(Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Записывает сообщение об ошибке обмена в журнал регистрации.
//
// Параметры:
//  ИмяСобытия - Строка - имя события журнала регистрации.
//  Текст      - Строка - текст сообщения.
//
Процедура ЗаписатьОшибкуВЖурнал(ИмяСобытия, Текст)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Текст);
	
КонецПроцедуры

#КонецОбласти
